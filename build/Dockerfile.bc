# LibreOffice-only Gotenberg image.
#
# Compared to upstream Gotenberg, this image:
#
#   - compiles the Chromium module out of the binary (the "nochromium" build
#     tag), so /forms/chromium/* does not exist, no chromium-* flag exists, and
#     no browser process can be spawned;
#   - deletes Chromium from the base image's root filesystem and from its
#     package database, then rebuilds the image FROM scratch so the bytes
#     actually leave the image rather than being hidden behind an overlay
#     whiteout;
#   - disables the "download from" feature and the webhook feature by default,
#     leaving no code path that fetches a remote input or posts a result back
#     out. Both remain overridable per deployment through the upstream
#     API_DISABLE_DOWNLOAD_FROM and WEBHOOK_DISABLE environment variables.
#
# The LibreOffice conversion route, the PDF engines and the whole /forms/pdfengines
# surface are untouched.
#
# Because the final stage is FROM scratch, it inherits no configuration from the
# base image: every ENV, the USER, the WORKDIR and the ENTRYPOINT are declared
# explicitly below rather than inherited. build/scrub-chromium.sh asserts that
# the paths they point at exist, so a base image change that invalidates them
# fails the build instead of producing a broken image.

ARG GOLANG_VERSION=1.26.6
ARG GOTENBERG_VERSION=8.36.0
ARG BASE_IMAGE=nexus.int.onebrief.tools/cgr.dev/onebrief.com/gotenberg
ARG BUSYBOX_IMAGE=busybox:stable-uclibc
ARG UNOCONVERTER_BIN_PATH=/usr/bin/unoconv

# Build tags for the Gotenberg binary. "nochromium" removes the Chromium module.
# Build with --build-arg GO_BUILD_TAGS= to get the upstream module set back.
ARG GO_BUILD_TAGS=nochromium

# Runtime user. The base image's own USER cannot be inherited through the
# flattening stage, so it is pinned here; the values match upstream Gotenberg.
ARG RUNTIME_USER=gotenberg
ARG RUNTIME_UID=1001
ARG RUNTIME_GID=1001
ARG RUNTIME_HOME=/home/gotenberg

# ----------------------------------------------
# Gotenberg binary build stage
# ----------------------------------------------
FROM golang:$GOLANG_VERSION AS binary-stage

ARG GOTENBERG_VERSION
ARG GO_BUILD_TAGS
ENV CGO_ENABLED=0

# Define the working directory outside of $GOPATH (we're using go modules).
WORKDIR /home

# Install module dependencies.
COPY go.mod go.sum ./

RUN go mod download &&\
  go mod verify

# Copy the source code.
COPY cmd ./cmd
COPY pkg ./pkg

RUN go build -tags "$GO_BUILD_TAGS" -o gotenberg -ldflags "-X 'github.com/gotenberg/gotenberg/v8/cmd.Version=$GOTENBERG_VERSION'" cmd/gotenberg/main.go

# Fail the build if the Chromium module survived the build tags, so that the
# image can never quietly ship a browser again.
RUN case "$GO_BUILD_TAGS" in \
  *nochromium*) \
  if ./gotenberg --help 2>&1 | grep -qi chromium; then \
  echo "FATAL: the binary still exposes Chromium flags despite the nochromium build tag" >&2; \
  exit 1; \
  fi; \
  echo "verified: the Gotenberg binary exposes no Chromium flags"; \
  ;; \
  esac

# ----------------------------------------------
# Base image stage
# ----------------------------------------------
# Nothing runs here: the Chainguard base is distroless, so it has no shell. It
# only exists so that the next stage can copy its root filesystem out.
FROM $BASE_IMAGE:$GOTENBERG_VERSION AS base-stage

# ----------------------------------------------
# Chromium scrub stage
# ----------------------------------------------
FROM $BUSYBOX_IMAGE AS scrub-stage

ARG UNOCONVERTER_BIN_PATH
ARG RUNTIME_USER
ARG RUNTIME_UID
ARG RUNTIME_GID
ARG RUNTIME_HOME

COPY --from=base-stage / /rootfs
COPY build/scrub-chromium.sh /usr/local/bin/scrub-chromium.sh

# The scrub fails the build if any of the binaries the LibreOffice-only image
# still depends on went missing.
RUN chmod +x /usr/local/bin/scrub-chromium.sh &&\
  ROOTFS=/rootfs \
  RUNTIME_USER="$RUNTIME_USER" \
  RUNTIME_UID="$RUNTIME_UID" \
  RUNTIME_GID="$RUNTIME_GID" \
  RUNTIME_HOME="$RUNTIME_HOME" \
  REQUIRED_PATHS="/usr/bin/tini /usr/lib/libreoffice/program/soffice.bin $UNOCONVERTER_BIN_PATH /usr/bin/pdftk /usr/bin/qpdf /usr/bin/exiftool /usr/bin/pdfcpu" \
  /usr/local/bin/scrub-chromium.sh

# ----------------------------------------------
# Final stage
# ----------------------------------------------
FROM scratch

ARG GOTENBERG_VERSION
ARG UNOCONVERTER_BIN_PATH
ARG RUNTIME_USER
ARG RUNTIME_UID
ARG RUNTIME_GID
ARG RUNTIME_HOME

LABEL org.opencontainers.image.title="Gotenberg (LibreOffice-only)" \
  org.opencontainers.image.description="A containerized API for seamless PDF conversion, without Chromium." \
  org.opencontainers.image.version="$GOTENBERG_VERSION"

COPY --from=scrub-stage /rootfs /
COPY --from=binary-stage /home/gotenberg /usr/bin/gotenberg

# Mitigation for CVE-2012-5639 (LibreOffice resolving external references).
# Note: this has to land in the runtime user's home directory. Docker does not
# expand "~", so an unexpanded path would silently create a directory literally
# named "~" and LibreOffice would never read the file.
COPY --chown=$RUNTIME_UID:0 --chmod=664 cve-fixes/cve-2012-5639/registrymodifications.xcu $RUNTIME_HOME/.config/libreoffice/4/user/registrymodifications.xcu

# Nothing is inherited from the base image: declare the whole environment.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV HOME=$RUNTIME_HOME
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Environment variables required by modules or else.
# Note: no CHROMIUM_* variables - that module is not compiled in.
ENV LIBREOFFICE_BIN_PATH=/usr/lib/libreoffice/program/soffice.bin
ENV UNOCONVERTER_BIN_PATH=$UNOCONVERTER_BIN_PATH
ENV PDFTK_BIN_PATH=/usr/bin/pdftk
ENV QPDF_BIN_PATH=/usr/bin/qpdf
ENV EXIFTOOL_BIN_PATH=/usr/bin/exiftool
ENV PDFCPU_BIN_PATH=/usr/bin/pdfcpu

# No ingress of remote content and no egress back to the application: Gotenberg
# neither fetches input documents from a URL nor posts results to a callback.
# Both are upstream flags, so a deployment that needs them can set these back to
# false.
ENV API_DISABLE_DOWNLOAD_FROM=true
ENV WEBHOOK_DISABLE=true

USER $RUNTIME_USER
WORKDIR $RUNTIME_HOME

# Default API port.
EXPOSE 3000

# tini reaps the zombie processes left behind by LibreOffice.
ENTRYPOINT [ "/usr/bin/tini", "--" ]
CMD [ "/usr/bin/gotenberg" ]
